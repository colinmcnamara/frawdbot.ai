---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'FrawdBot - Detecting AI-Accelerated Insider Threats',
  description = 'FrawdBot detects the two threats nobody else is covering: malicious insiders accelerating attacks with AI tools, and autonomous agents that become insider threats themselves. Launching on Google Workspace, Microsoft 365 in development.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XY3X2YTYH6"></script>
    <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-XY3X2YTYH6');
    </script>
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <slot />
</body>
</html>
